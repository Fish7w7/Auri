{
  "name": "lumi-desktop",
  "version": "0.6.0",
  "description": "Biblioteca local-first para obras seriadas",
  "author": "Lumi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fish7w7/Lumi.git"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build:app && electron . --smoke-test",
    "test:visual": "npm run build:app && electron . --screenshot-test",
    "test:backup-smoke": "npm run build:app && electron . --backup-smoke-test",
    "build:app": "electron-vite build",
    "build": "npm run typecheck && npm run test && npm run build:app",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "release:win": "npm run build && electron-builder --win nsis --x64 --publish always"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "app.lumi.desktop",
    "productName": "Lumi",
    "artifactName": "Lumi-Setup-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/better-sqlite3/prebuilds/darwin-*.node",
      "!node_modules/better-sqlite3/prebuilds/linux-*.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-*.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node",
      "!node_modules/sharp/install/**/*",
      "!node_modules/sharp/src/**/*",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/prebuilds/win32-x64.node",
      "node_modules/@img/sharp-win32-x64/lib/**/*"
    ],
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Fish7w7",
        "repo": "Lumi",
        "releaseType": "draft",
        "channel": "latest"
      }
    ]
  }
}
